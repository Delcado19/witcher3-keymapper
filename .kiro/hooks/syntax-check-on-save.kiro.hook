{
  "enabled": true,
  "name": "Syntax Check on Save",
  "description": "Runs node --check on server.js and app.js whenever either file is saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "server.js",
      "public/app.js"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "node --check server.js & node --check public/app.js"
  }
}