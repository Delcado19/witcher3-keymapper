{
  "enabled": true,
  "name": "Backup Warning for input.settings",
  "description": "Before any write tool is used, checks if input.settings is among the files being modified and warns if no recent backup exists",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if the write operation targets input.settings. If it does, verify that a backup file matching the pattern input.settings.*.bak exists in the project root. If no backup exists, warn the user and do NOT proceed with the write until a backup is confirmed. If the target is not input.settings, allow the operation to proceed normally."
  }
}