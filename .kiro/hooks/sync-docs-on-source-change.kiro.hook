{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When any source file (JS, HTML, CSS, or input.settings) is edited, ask the agent to update the README or docs to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "server.js",
      "public/app.js",
      "public/index.html",
      "public/styles.css",
      "input.settings"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the changes and update the README.md (create it if it doesn't exist) or any relevant documentation in a /docs folder to reflect what changed. Focus on user-facing behavior, API endpoints, configuration, and usage instructions. Do not update AI_JOURNAL.md — that is handled separately."
  }
}