{
  "enabled": true,
  "name": "GitHub Push on Agent Stop",
  "description": "After the agent finishes a session, automatically stages all changes, commits with a summary message, and pushes to the remote GitHub repository.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git diff --cached --quiet || git commit -m \"Auto-commit: agent session changes\" && git push"
  }
}