{
  "enabled": true,
  "name": "Journal Update Reminder",
  "description": "After each agent session, reminds the user to write a curated entry in AI_JOURNAL.md if code was changed",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if any code changes were made this session. If yes, remind the user to add a curated entry to AI_JOURNAL.md under \"Kuratiertes Log\" with: date, tool, what changed, files affected, reasoning, and open threads / next steps. Do not write the entry yourself — just remind the user with a brief summary of what was done."
  }
}