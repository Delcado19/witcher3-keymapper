# dependencies
/node_modules

# Witcher 3 user data — local working copy of the keybinding file, NOT source code.
# Treat input.settings as user data (see AGENTS.md). A single rolling backup is
# written next to it as input.settings.bak by server.js (older builds used a
# per-change input.settings.<timestamp>.bak; the glob still covers those).
/input.settings
/input.settings*.bak

# local AI/tool handoff state
/AI_JOURNAL.md
/CLAUDE.md
/.claude/

# local reference material (in-game controls screenshots used to source curated
# display names) — kept locally, never committed (large binary, not source).
/screenshots/

# misc
.cache/
.DS_Store
npm-debug.log*
