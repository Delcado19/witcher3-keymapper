
# ============================================================
# Witcher 3 Keymapper - .gitignore
# ============================================================

# Node.js dependencies
/node_modules/

# Witcher 3 user data
# Local working copy - never commit personal game settings.
/input.settings
/input.settings*.bak

# Local AI context and handoff files
/AI_JOURNAL.md
/CLAUDE.md
/.claude/

# Local reference screenshots
/screenshots/

# Graphify - keep graph and reports versioned,
# but exclude locally generated caches.
/graphify-out/cache/

# Local environment and secrets
.env
.env.*
!.env.example

# Test and coverage output
/coverage/

# Local caches
.cache/

# Graphify: generated local cache
/graphify-out/cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# IDE and editor settings
.vscode/
.idea/
